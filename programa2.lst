     1                                  ; programa2.asm - Laboratorio Post1 Unidad 4, Parte 2
     2                                  ; Proposito: macros con parametros, bucles con LOOP y condicionales con CMP/Jcc
     3                                   
     4                                  %include "macros.asm"       ; biblioteca de macros utilitarias
     5                              <1> ; macros.asm - biblioteca de macros utilitarias (Laboratorio Post1 U4, Parte 2)
     6                              <1> ; Todas las macros se apoyan en la interrupcion INT 21h de DOS.
     7                              <1> 
     8                              <1> ; Macro: terminar el programa DOS con codigo de salida 0
     9                              <1> %macro fin_dos 0
    10                              <1>     mov  ax, 4C00h
    11                              <1>     int  21h
    12                              <1> %endmacro
    13                              <1> 
    14                              <1> ; Macro: imprimir nueva linea (CR + LF)
    15                              <1> %macro nueva_linea 0
    16                              <1>     mov  ah, 02h
    17                              <1>     mov  dl, 0Dh
    18                              <1>     int  21h
    19                              <1>     mov  dl, 0Ah
    20                              <1>     int  21h
    21                              <1> %endmacro
    22                              <1> 
    23                              <1> ; Macro: imprimir cadena terminada en "$"
    24                              <1> ; %1 = etiqueta de la cadena
    25                              <1> ; La funcion 09h deja AL = 24h al terminar, lo que arruinaria un print_digito
    26                              <1> ; posterior; por eso la macro preserva AX con PUSH/POP.
    27                              <1> %macro print_str 1
    28                              <1>     push ax
    29                              <1>     mov  ah, 09h
    30                              <1>     mov  dx, %1
    31                              <1>     int  21h
    32                              <1>     pop  ax
    33                              <1> %endmacro
    34                              <1> 
    35                              <1> ; Macro: imprimir un caracter unico
    36                              <1> ; %1 = valor ASCII del caracter (inmediato o registro de 8 bits)
    37                              <1> %macro print_char 1
    38                              <1>     mov  ah, 02h
    39                              <1>     mov  dl, %1
    40                              <1>     int  21h
    41                              <1> %endmacro
    42                              <1> 
    43                              <1> ; Macro: leer un caracter desde teclado (sin eco); el resultado queda en AL
    44                              <1> %macro leer_char 0
    45                              <1>     mov  ah, 07h
    46                              <1>     int  21h
    47                              <1> %endmacro
    48                              <1> 
    49                              <1> ; Macro: imprimir una cadena N veces (bucle en tiempo de ejecucion con LOOP)
    50                              <1> ; %1 = etiqueta de la cadena a imprimir
    51                              <1> ; %2 = numero de repeticiones (inmediato numerico)
    52                              <1> %macro repetir_str 2
    53                              <1>     mov  cx, %2             ; CX = contador de repeticiones
    54                              <1> %%ciclo:                    ; %% genera una etiqueta unica por expansion
    55                              <1>     mov  ah, 09h
    56                              <1>     mov  dx, %1
    57                              <1>     int  21h
    58                              <1>     loop %%ciclo            ; CX--; si CX != 0, repetir
    59                              <1> %endmacro
    60                              <1> 
    61                              <1> ; Macro: imprimir el digito decimal (0-9) almacenado en AL
    62                              <1> %macro print_digito 0
    63                              <1>     push ax                 ; preservar AX
    64                              <1>     and  al, 0Fh            ; quedarse con el nibble bajo
    65                              <1>     add  al, 30h            ; convertir a ASCII
    66                              <1>     mov  ah, 02h
    67                              <1>     mov  dl, al
    68                              <1>     int  21h
    69                              <1>     pop  ax                 ; restaurar AX
    70                              <1> %endmacro
    71                              <1> 
    72                              <1> ; Macro: imprimir un separador corto N veces, desenrollada en tiempo de ensamblado
    73                              <1> ; %1 = numero de copias (constante conocida al ensamblar)
    74                              <1> ; Requiere que exista la etiqueta separador_corto en el programa que la use.
    75                              <1> %macro bloque_decorativo 1
    76                              <1>     %rep %1
    77                              <1>     print_str separador_corto   ; cada copia se expande como codigo independiente
    78                              <1>     %endrep
    79                              <1> %endmacro
