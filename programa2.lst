    68                                  ; ---------------------------------------------------------------------------
    69                                  ; Procedimiento: suma acumulativa 1+2+...+N
    70                                  ; Entrada: CX = N        Salida: AX = suma total
    71                                  ; ---------------------------------------------------------------------------
    72                                  sumar_serie:
    73 00000083 51                          push cx                 ; preservar CX (LOOP lo modifica)
    74 00000084 31C0                        xor  ax, ax             ; AX = 0 (acumulador)
    75                                  .paso:
    76 00000086 01C8                        add  ax, cx             ; AX += CX
    77 00000088 E2FC                        loop .paso              ; CX--; si CX != 0, continuar
    78 0000008A 59                          pop  cx                 ; restaurar CX original
    79 0000008B C3                          ret
    80                                   
    81                                  ; ---------------------------------------------------------------------------
    82                                  ; Procedimiento: comparar AX y BX e imprimir el mayor (decide con JE y JG)
    83                                  ; ---------------------------------------------------------------------------
    84                                  comparar_e_imprimir:
    85 0000008C 50                          push ax
    86 0000008D 53                          push bx
    87                                   
    88 0000008E 39D8                        cmp  ax, bx             ; flags de AX - BX
    89 00000090 7446                        je   .son_iguales       ; AX == BX
    90 00000092 7F23                        jg   .ax_mayor          ; AX > BX (con signo)
    91                                   
    92                                      ; Caso: BX es mayor
    93                                      print_str msg_mayor
